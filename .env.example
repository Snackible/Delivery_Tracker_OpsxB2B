# Copy to .env for local use (loaded by `npm run dev`), and set the same names in the
# Vercel project's Environment Variables. Never commit the real values.
# With none of the Google values set, the app runs on bundled demo data.

# ---- Google Sheets (service account) ----
# Share both spreadsheets with this address: Editor on both sheets (the users sheet is edited when someone saves a missing email or number).
GOOGLE_SERVICE_ACCOUNT_EMAIL=snackible-aditi@turing-guard-506009-g7.iam.gserviceaccount.com
# The "private_key" value from the downloaded JSON key, on one line, with \n for line breaks.
GOOGLE_PRIVATE_KEY=

# Orders spreadsheet (BD Ops Sales Tracking Sheet). Tab names below are the defaults.
SHEET_ID_ORDERS=14Ak4MyWC4ebqzK-P19o_2bBE-qItK7K-WQQ-0_1q08o
ORDERS_TAB=Sheet1
LEADS_TAB=Sheet2

# Users spreadsheet: username, password, role, account_id, display_name, Email, Contact
SHEET_ID_USERS=1RKbmZ-MWJ-JNyNe7WzO7HZfmfWQZL4RXJ_Gs8PiCA6Q
USERS_TAB=Users

# ---- App ----
# Long random string used to sign login cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Public address of the deployed app, used for links in emails.
APP_URL=

# ---- Daily email to ops ----
# Shared secret the Apps Script timer sends as "Authorization: Bearer <value>". 16+ random characters.
CRON_SECRET=
# No email goes out before this hour (India time).
DIGEST_HOUR_IST=9
# Email provider (Resend). EMAIL_FROM must be on a domain verified at the provider; users whose
# own address is on that domain are sent "as themselves", others get Reply-To set to them.
RESEND_API_KEY=
EMAIL_FROM=tracker@snackible.com
